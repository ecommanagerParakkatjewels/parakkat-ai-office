# Copy to .env.local for development. Never commit the real file.
# On Vercel, set these in Project Settings -> Environment Variables.

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase: Project Settings -> Database -> Connection string (Transaction pooler, port 6543)
# Server-only. Used for all data access; the browser never touches the tables.
DATABASE_URL=

# Who may sign in: comma-separated emails. Empty = nobody (fails closed).
# Checked on every request, so an account created by mistake in Supabase still cannot get in.
ALLOWED_EMAILS=

# Which business this deployment serves (row in office.tenants)
TENANT_SLUG=jewels

# Anthropic Console -> API keys. Server-only. Not used until Day 4.
ANTHROPIC_API_KEY=
